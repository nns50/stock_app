# ----------------------------------------------------------------------------
# stock-app environment configuration
# Copy this file to server/.env and fill in your values.
#   cp .env.example server/.env
# All market-data keys live SERVER-SIDE only. The frontend never sees them.
# ----------------------------------------------------------------------------

# Which market data provider to use: "yahoo" | "tradier" | "mock"
#   yahoo  - FREE, no API key. Stocks + options chains (Greeks computed locally).
#            Unofficial (personal use; may rate-limit or change).
#   tradier- Live data; requires a Tradier brokerage account / data subscription.
#   mock   - Keyless deterministic synthetic data (demo, tests, offline dev).
MARKET_DATA_PROVIDER=mock

# --- Tradier (https://documentation.tradier.com/) ---------------------------
# Create a developer account and use a sandbox or brokerage access token.
# Sandbox base URL: https://sandbox.tradier.com/v1
# Production base URL: https://api.tradier.com/v1
TRADIER_API_TOKEN=
TRADIER_BASE_URL=https://sandbox.tradier.com/v1

# --- Server ----------------------------------------------------------------
PORT=3001

# Where the SQLite database file is stored (relative to server/ or absolute).
DATABASE_PATH=./data/stock_app.db

# Quote cache TTL in milliseconds (reduces provider calls / respects rate limits)
QUOTE_CACHE_TTL_MS=15000
CANDLE_CACHE_TTL_MS=60000

# Comma-separated list of allowed CORS origins for the API (frontend dev server)
CORS_ORIGINS=http://localhost:5173
