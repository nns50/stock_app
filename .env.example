# ----------------------------------------------------------------------------
# stock-app environment configuration
# Copy this file to server/.env and fill in your values.
#   cp .env.example server/.env
# All market-data keys live SERVER-SIDE only. The frontend never sees them.
# ----------------------------------------------------------------------------

# Which market data provider to use: "yahoo" | "tradier" | "mock"
#   yahoo  - FREE, no API key. Stocks + options chains (Greeks computed locally).
#            Unofficial (personal use; may rate-limit or change).
#   tradier- Live data; requires a Tradier brokerage account / data subscription.
#   mock   - Keyless deterministic synthetic data (demo, tests, offline dev).
MARKET_DATA_PROVIDER=mock

# --- Tradier (https://documentation.tradier.com/) ---------------------------
# Create a developer account and use a sandbox or brokerage access token.
# Sandbox base URL: https://sandbox.tradier.com/v1
# Production base URL: https://api.tradier.com/v1
TRADIER_API_TOKEN=
TRADIER_BASE_URL=https://sandbox.tradier.com/v1

# --- Server ----------------------------------------------------------------
PORT=3001

# Where the SQLite database file is stored (relative to server/ or absolute).
DATABASE_PATH=./data/stock_app.db

# Quote cache TTL in milliseconds (reduces provider calls / respects rate limits)
QUOTE_CACHE_TTL_MS=15000
CANDLE_CACHE_TTL_MS=60000

# Comma-separated list of allowed CORS origins for the API (frontend dev server)
CORS_ORIGINS=http://localhost:5173

# --- Alert notifications (background poller) --------------------------------
# When the server-side alert poller is enabled (Settings → Alerts) and an alert
# fires, the server POSTs it to every webhook set below — so you're notified even
# with the browser closed. Set any/all; they fire at once. URLs are secrets:
# never commit them.

# Slack Incoming Webhook (https://api.slack.com/messaging/webhooks)
SLACK_WEBHOOK_URL=
# Discord channel webhook (Server Settings → Integrations → Webhooks)
DISCORD_WEBHOOK_URL=
# Generic webhook — e.g. phone push via an ntfy topic (https://ntfy.sh/your-topic),
# Zapier, or your own endpoint. Format adapts the JSON body.
ALERT_WEBHOOK_URL=
# Payload shape for ALERT_WEBHOOK_URL: "json" (generic {title,text,events}) | "slack" | "discord"
ALERT_WEBHOOK_FORMAT=json

# --- App login (single password) -------------------------------------------
# Set APP_PASSWORD to require a login before any data is served — use this when
# exposing the app on a public URL (it has no accounts; this is one shared
# password). Leave blank to disable auth (local dev / private network).
APP_PASSWORD=
# The session cookie is marked Secure in production (HTTPS) by default. If you
# reach the app over plain http (e.g. behind `fly proxy`), set this to false.
# AUTH_SECURE_COOKIE=false
