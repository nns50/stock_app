{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "description": "API layer: holds market-data keys, serves quotes/candles/options, runs the screener engine, persists positions/journal in SQLite.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:provider": "tsx src/scripts/checkProvider.ts",
    "capture:broker": "tsx src/scripts/captureBrokerFields.ts",
    "backfill:exits": "tsx src/scripts/backfillExitPrices.ts",
    "check:journal": "tsx src/scripts/checkJournal.ts",
    "research": "tsx src/scripts/researchSweep.ts",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "yahoo-finance2": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
